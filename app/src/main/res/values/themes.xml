<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DarkPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenBackground">#0E0E10</item>
        <item name="postSplashScreenTheme">@style/Theme.DarkPlayer</item>
    </style>

    <style name="Theme.DarkPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#0E0E10</item>
        <item name="android:statusBarColor">#0E0E10</item>
        <item name="android:navigationBarColor">#0E0E10</item>
        <item name="android:fontFamily">@font/darkplayer_font</item>
        <item name="fontFamily">@font/darkplayer_font</item>
    </style>
</resources>
