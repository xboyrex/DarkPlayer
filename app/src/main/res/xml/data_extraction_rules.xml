<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="vault_security_prefs.xml" />
        <exclude domain="database" path="NextPlayer.db" />
        <exclude domain="database" path="NextPlayer.db-shm" />
        <exclude domain="database" path="NextPlayer.db-wal" />
        <exclude domain="external" path="vault" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="vault_security_prefs.xml" />
        <exclude domain="database" path="NextPlayer.db" />
        <exclude domain="database" path="NextPlayer.db-shm" />
        <exclude domain="database" path="NextPlayer.db-wal" />
        <exclude domain="external" path="vault" />
    </device-transfer>
</data-extraction-rules>
